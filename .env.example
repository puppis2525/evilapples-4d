# Copy to .env and fill in outside the repository. Do not commit .env.
# Leave values empty in this example. Do not paste live keys here.

# Discord bot and website OAuth. The website login uses the identify scope.
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Required. python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=

# global publishes slash commands for the App Directory install.
# guild plus DISCORD_GUILD_ID updates one test server in seconds.
DISCORD_COMMAND_SCOPE=global
DISCORD_GUILD_ID=

# false: slash commands only, message content intent stays off.
# true: also accept ! commands and request the privileged message content intent.
ENABLE_LEGACY_PREFIX_COMMANDS=false
# false: do not request the privileged guild members intent.
ENABLE_MEMBERS_INTENT=false

# nsfw_channel restricts gameplay to Discord age-restricted channels.
# off removes that gate. It does not make the app Directory-eligible.
MATURE_CONTENT_ENFORCEMENT=nsfw_channel

# Canonical https origin. Used for Stripe return URLs even behind a proxy.
PUBLIC_BASE_URL=
DATABASE_URL=
CORS_ALLOWED_ORIGINS=

# Preferred Stripe setup. Leave empty only if a Replit Stripe connector is configured.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# Price ids from your Stripe account. They must match the advertised plan amounts.
STRIPE_PRICE_ID=
STRIPE_PRICE_ID_SCHEMER=
STRIPE_PRICE_ID_OVERLORD=

VENICE_API_KEY=

# Telegram keeps its own process. TELEGRAM_BOT_CODE is an accepted alias.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
WEB_BASE_URL=

# true skips the Discord connection and still serves the website.
DISABLE_DISCORD_BOT=false

# Optional. Public pages load AdSense only when this is set.
ADSENSE_PUBLISHER_ID=
